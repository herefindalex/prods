{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/herefindalex/prods/sample-data/schema-v1.json",
  "title": "Prods installer sample data v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release_version", "dataset_version", "seed", "source_statement", "categories", "products"],
  "properties": {
    "schema_version": { "const": 1 },
    "release_version": { "type": "string", "minLength": 1 },
    "dataset_version": { "type": "string", "minLength": 1 },
    "seed": { "type": "integer" },
    "source_statement": { "type": "string", "minLength": 1 },
    "categories": {
      "type": "array",
      "items": { "$ref": "#/$defs/category" }
    },
    "products": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/product" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,120}$" },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "slug"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "parent_id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 240 },
        "description": { "type": "string", "maxLength": 4000 },
        "source_locale": { "type": "string", "minLength": 2, "maxLength": 35 },
        "slug": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,120}$" },
        "status": { "enum": ["active", "disabled"] }
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "part_number"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "part_number": { "type": "string", "minLength": 1, "maxLength": 240 },
        "name": { "type": "string", "maxLength": 500 },
        "manufacturer": { "type": "string", "maxLength": 500 },
        "category_id": { "$ref": "#/$defs/id" },
        "package_form_factor": { "type": "string", "maxLength": 500 },
        "description": { "type": "string", "maxLength": 20000 },
        "features": { "type": "string", "maxLength": 20000 },
        "specification": { "type": "string", "maxLength": 20000 },
        "document_url": { "type": "string", "format": "uri", "maxLength": 2000 },
        "status": { "enum": ["hidden", "published"] },
        "record_state": { "enum": ["current", "archived"] }
      }
    }
  }
}
