{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/herefindalex/prods/sample-data/schema-v1.json",
  "title": "Prods installer sample data v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_version",
    "dataset_version",
    "seed",
    "source_statement",
    "dictionaries",
    "categories",
    "specs",
    "spec_sets",
    "category_spec_sets",
    "products"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "release_version": { "type": "string", "minLength": 1 },
    "dataset_version": { "type": "string", "minLength": 1 },
    "seed": { "type": "integer" },
    "source_statement": { "type": "string", "minLength": 1 },
    "dictionaries": { "type": "array", "items": { "$ref": "#/$defs/dictionary" } },
    "categories": { "type": "array", "items": { "$ref": "#/$defs/category" } },
    "specs": { "type": "array", "items": { "$ref": "#/$defs/spec" } },
    "spec_sets": { "type": "array", "items": { "$ref": "#/$defs/specSet" } },
    "category_spec_sets": { "type": "array", "items": { "$ref": "#/$defs/categorySpecSet" } },
    "products": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/product" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,120}$" },
    "locale": { "type": "string", "minLength": 2, "maxLength": 35 },
    "entryStatus": { "enum": ["active", "disabled"] },
    "dictionary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "name"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["manufacturer", "brand", "application", "lifecycle"] },
        "name": { "type": "string", "minLength": 1, "maxLength": 500 },
        "description": { "type": "string", "maxLength": 4000 },
        "source_locale": { "$ref": "#/$defs/locale" },
        "slug": { "$ref": "#/$defs/id" },
        "status": { "$ref": "#/$defs/entryStatus" }
      }
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "slug"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "parent_id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 240 },
        "description": { "type": "string", "maxLength": 4000 },
        "source_locale": { "$ref": "#/$defs/locale" },
        "slug": { "$ref": "#/$defs/id" },
        "status": { "$ref": "#/$defs/entryStatus" }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "filterable", "semantic_version"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 500 },
        "preferred_unit": { "type": "string", "maxLength": 120 },
        "filterable": { "type": "boolean" },
        "semantic_version": { "type": "integer", "minimum": 1 },
        "status": { "$ref": "#/$defs/entryStatus" }
      }
    },
    "specSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "spec_ids"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 500 },
        "status": { "$ref": "#/$defs/entryStatus" },
        "spec_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
      }
    },
    "categorySpecSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category_id", "spec_set_id"],
      "properties": {
        "category_id": { "$ref": "#/$defs/id" },
        "spec_set_id": { "$ref": "#/$defs/id" }
      }
    },
    "specValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spec_id", "raw_value"],
      "properties": {
        "spec_id": { "$ref": "#/$defs/id" },
        "raw_value": { "type": "string", "minLength": 1, "maxLength": 20000 },
        "source_locale": { "$ref": "#/$defs/locale" }
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "part_number"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "part_number": { "type": "string", "minLength": 1, "maxLength": 240 },
        "name": { "type": "string", "maxLength": 500 },
        "source_locale": { "$ref": "#/$defs/locale" },
        "manufacturer_id": { "$ref": "#/$defs/id" },
        "manufacturer": { "type": "string", "maxLength": 500 },
        "brand_id": { "$ref": "#/$defs/id" },
        "brand": { "type": "string", "maxLength": 500 },
        "lifecycle_id": { "$ref": "#/$defs/id" },
        "application_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "category_id": { "$ref": "#/$defs/id" },
        "package_form_factor": { "type": "string", "maxLength": 500 },
        "description": { "type": "string", "maxLength": 20000 },
        "features": { "type": "string", "maxLength": 20000 },
        "specification": { "type": "string", "maxLength": 20000 },
        "document_url": { "type": "string", "format": "uri", "maxLength": 2000 },
        "status": { "enum": ["hidden", "published"] },
        "record_state": { "enum": ["current", "archived"] },
        "spec_values": { "type": "array", "items": { "$ref": "#/$defs/specValue" } }
      }
    }
  }
}
