{{define "header"}}<!doctype html>
<html lang="{{.Language}}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<link rel="stylesheet" href="/static/system/system.css"><title>{{.Title}}</title></head>
<body><header><a href="/"><strong>Prods</strong></a><nav><a href="/search">{{.Text.Catalog}}</a> <a href="/rfq">{{.Text.RequestPart}}</a></nav></header><main>{{end}}
{{define "footer"}}</main><footer>{{.Text.Footer}}</footer></body></html>{{end}}

{{define "public-nav-nodes"}}{{range .}}<li>{{if .Children}}<details class="site-nav-group"><summary>{{.Item.Label}}</summary>{{if .Item.URL}}<a class="site-nav-overview" href="{{.Item.URL}}" aria-label="{{.Item.Label}}" title="{{.Item.Label}}"{{if .Item.OpenNewWindow}} target="_blank" rel="noopener noreferrer"{{end}}><span aria-hidden="true">→</span></a>{{end}}<ul>{{template "public-nav-nodes" .Children}}</ul></details>{{else if .Item.URL}}<a href="{{.Item.URL}}"{{if .Item.OpenNewWindow}} target="_blank" rel="noopener noreferrer"{{end}}>{{.Item.Label}}</a>{{else}}<span>{{.Item.Label}}</span>{{end}}</li>{{end}}{{end}}

{{define "public-header"}}<!doctype html>
<html lang="{{.Language}}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<link rel="stylesheet" href="/static/public/public.css">{{if .JSONURL}}<link rel="alternate" type="application/json" href="{{.JSONURL}}">{{end}}{{if .MarkdownURL}}<link rel="alternate" type="text/markdown" href="{{.MarkdownURL}}">{{end}}{{if .Site.Organization.FaviconAsset}}<link rel="icon" href="/assets/{{.Site.Organization.FaviconAsset}}">{{end}}<style>{{.Stylesheet}}</style>{{if .Site.Theme.CustomCSSEnabled}}<link rel="stylesheet" href="/site.css?v={{.SiteEpoch}}">{{end}}<title>{{.Title}}</title></head>
<body data-site-epoch="{{.SiteEpoch}}"><header class="site-header site-header-{{.Site.Header.Layout}}{{if .Site.Header.Sticky}} is-sticky{{end}}">
{{range .Site.Header.Rows}}{{if eq .Type "announcement"}}<div class="site-header-row announcement-row">{{range .Items}}{{if eq .Kind "text"}}<span>{{.Text}}</span>{{else if eq .Kind "link"}}<a href="{{headerURL .URL}}">{{.Label}}</a>{{end}}{{end}}</div>{{end}}{{end}}
{{range .Site.Header.Rows}}{{if eq .Type "utility"}}<div class="site-header-row utility-row">{{range .Items}}{{if eq .Kind "text"}}<span>{{.Text}}</span>{{else if eq .Kind "link"}}<a href="{{headerURL .URL}}">{{.Label}}</a>{{else if eq .SystemAction "rfq"}}<a href="{{$.RFQURL}}">{{$.Text.RequestQuote}}</a>{{else if eq .SystemAction "catalog"}}<a href="{{$.CatalogURL}}">{{$.Text.Catalog}}</a>{{else if eq .SystemAction "catalog_search"}}<a href="{{$.SearchURL}}">{{$.Text.Search}}</a>{{end}}{{end}}</div>{{end}}{{end}}
<div class="site-header-row main-row"><a class="site-brand" href="{{.CatalogURL}}"><strong>{{if .Site.Organization.PrimaryLogoAsset}}<img src="/assets/{{.Site.Organization.PrimaryLogoAsset}}" alt="{{.Site.Organization.DisplayName}}">{{else}}{{.Site.Organization.DisplayName}}{{end}}</strong></a>
{{range .Site.Header.Rows}}{{if eq .Type "main"}}{{range .Items}}{{if eq .Kind "link"}}<a href="{{headerURL .URL}}">{{.Label}}</a>{{else if eq .SystemAction "catalog_search"}}<form class="header-search" action="{{$.SearchURL}}" method="get" role="search"><label><span class="visually-hidden">{{$.Text.SearchLabel}}</span><input name="q" placeholder="{{$.Text.SearchLabel}}"></label><button>{{$.Text.Search}}</button></form>{{else if eq .SystemAction "rfq"}}<a class="header-rfq" href="{{$.RFQURL}}">{{$.Text.RequestQuote}}</a>{{end}}{{end}}{{end}}{{end}}
{{if and .ShowHeaderLocale .LanguageOptions}}<details class="language-menu"><summary>{{range .LanguageOptions}}{{if .Active}}{{.Name}}{{end}}{{end}}</summary><nav aria-label="{{.Text.Language}}">{{range .LanguageOptions}}<a href="{{.URL}}" hreflang="{{.Locale}}"{{if .Active}} aria-current="page"{{end}}>{{.Name}}</a>{{end}}</nav></details>{{end}}</div>
{{if .NavigationTree}}<nav class="primary-navigation" aria-label="Primary"><ul>{{template "public-nav-nodes" .NavigationTree}}</ul></nav>{{end}}</header><main>{{end}}

{{define "public-footer"}}</main><footer class="site-footer site-footer-{{.Site.Footer.Layout}}">
<div class="footer-grid">{{if .Site.Footer.BrandBlock.ShowBrand}}<section class="footer-brand"><h2>{{.Site.Organization.DisplayName}}</h2>{{if and .Site.Footer.BrandBlock.ShowDescription .Site.Organization.Description}}<p>{{.Site.Organization.Description}}</p>{{end}}{{range $contactID := .Site.Footer.BrandBlock.ContactIDs}}{{range $.Site.Organization.Contacts}}{{if eq .ID $contactID}}<p>{{if .URL}}<a href="{{contactURL .URL}}">{{.Label}}: {{.Value}}</a>{{else}}<span>{{.Label}}: {{.Value}}</span>{{end}}</p>{{end}}{{end}}{{end}}</section>{{end}}
{{range .Site.Footer.Sections}}{{$section := .}}{{if .CollapsibleOnMobile}}<details class="footer-section footer-section-collapsible" open><summary>{{.Heading}}</summary><ul>{{range .Items}}<li>{{if eq .Kind "link"}}<a href="{{.URL}}">{{.Label}}</a>{{else if eq .Kind "text"}}<span>{{.Text}}</span>{{else if eq .Kind "contact_ref"}}{{$item := .}}{{range $.Site.Organization.Contacts}}{{if eq .ID $item.ContactID}}{{if .URL}}<a href="{{contactURL .URL}}">{{.Label}}: {{.Value}}</a>{{else}}<span>{{.Label}}: {{.Value}}</span>{{end}}{{end}}{{end}}{{else if eq .SystemAction "catalog"}}<a href="{{$.CatalogURL}}">{{$.Text.Catalog}}</a>{{else if eq .SystemAction "catalog_search"}}<a href="{{$.SearchURL}}">{{$.Text.Search}}</a>{{else if eq .SystemAction "rfq"}}<a href="{{$.RFQURL}}">{{$.Text.RequestQuote}}</a>{{else if eq .SystemAction "locale"}}<span>{{$.Text.Language}}</span>{{end}}</li>{{end}}</ul></details>{{else}}<section class="footer-section"><h2>{{.Heading}}</h2><ul>{{range .Items}}<li>{{if eq .Kind "link"}}<a href="{{.URL}}">{{.Label}}</a>{{else if eq .Kind "text"}}<span>{{.Text}}</span>{{else if eq .Kind "contact_ref"}}{{$item := .}}{{range $.Site.Organization.Contacts}}{{if eq .ID $item.ContactID}}{{if .URL}}<a href="{{contactURL .URL}}">{{.Label}}: {{.Value}}</a>{{else}}<span>{{.Label}}: {{.Value}}</span>{{end}}{{end}}{{end}}{{else if eq .SystemAction "catalog"}}<a href="{{$.CatalogURL}}">{{$.Text.Catalog}}</a>{{else if eq .SystemAction "catalog_search"}}<a href="{{$.SearchURL}}">{{$.Text.Search}}</a>{{else if eq .SystemAction "rfq"}}<a href="{{$.RFQURL}}">{{$.Text.RequestQuote}}</a>{{else if eq .SystemAction "locale"}}<span>{{$.Text.Language}}</span>{{end}}</li>{{end}}</ul></section>{{end}}{{end}}</div>
{{if and .Site.Footer.ShowSocialLinks .Site.Organization.SocialLinks}}<nav class="footer-social" aria-label="Social">{{range .Site.Organization.SocialLinks}}<a href="{{.URL}}" target="_blank" rel="noopener noreferrer">{{.Label}}</a>{{end}}</nav>{{end}}
<nav class="footer-legal" aria-label="Legal">{{range .Site.Footer.LegalLinks}}<a href="{{.URL}}">{{.Label}}</a>{{end}}{{if .Site.Organization.PrivacyURL}}<a href="{{.Site.Organization.PrivacyURL}}">{{.Text.Privacy}}</a>{{end}}{{if .Site.Organization.TermsURL}}<a href="{{.Site.Organization.TermsURL}}">{{.Text.Terms}}</a>{{end}}</nav>
{{if and .ShowFooterLocale .LanguageOptions}}<details class="language-menu footer-language"><summary>{{range .LanguageOptions}}{{if .Active}}{{.Name}}{{end}}{{end}}</summary><nav aria-label="{{.Text.Language}}">{{range .LanguageOptions}}<a href="{{.URL}}" hreflang="{{.Locale}}"{{if .Active}} aria-current="page"{{end}}>{{.Name}}</a>{{end}}</nav></details>{{end}}
<div class="footer-company">{{if .Site.Footer.CopyrightText}}<p>{{.Site.Footer.CopyrightText}}</p>{{else}}<p>{{if .Site.Organization.LegalName}}{{.Site.Organization.LegalName}}{{else}}{{.Site.Organization.DisplayName}}{{end}}</p>{{end}}{{range .Site.Footer.RegistrationLines}}<p>{{.}}</p>{{end}}{{if .Site.Footer.Disclaimer}}<p class="footer-disclaimer">{{.Site.Footer.Disclaimer}}</p>{{end}}</div></footer></body></html>{{end}}

{{define "search"}}{{template "public-header" .}}
<h1>{{.Title}}</h1>
<form action="{{.SearchURL}}" method="get" role="search"><input type="hidden" name="lang" value="{{.Language}}"><label>{{.Text.SearchLabel}} <input name="q" value="{{.Query}}"></label>
{{if .ManufacturerOptions}}<label>{{.Text.Manufacturer}} <select name="manufacturer_id"><option value="">{{.Text.All}}</option>{{range .ManufacturerOptions}}<option value="{{.Value}}"{{if .Selected}} selected{{end}}>{{.Label}}</option>{{end}}</select></label>{{end}}
{{if .BrandOptions}}<label>{{.Text.Brand}} <select name="brand_id"><option value="">{{.Text.All}}</option>{{range .BrandOptions}}<option value="{{.Value}}"{{if .Selected}} selected{{end}}>{{.Label}}</option>{{end}}</select></label>{{end}}
{{if .CategoryOptions}}<label>{{.Text.Category}} <select name="category_id"><option value="">{{.Text.All}}</option>{{range .CategoryOptions}}<option value="{{.Value}}"{{if .Selected}} selected{{end}}>{{.Label}}</option>{{end}}</select></label>{{end}}
<button>{{.Text.Search}}</button></form>
{{if .NoResults}}<section class="notice"><h2>{{.Text.NoProducts}}</h2><p>{{.Text.NoProductsPrefix}} <strong>{{.Query}}</strong>.</p>
<a class="button" href="{{.RequestURL}}">{{.Text.RequestThisPart}}</a></section>{{else}}
<ul class="products">{{range .Products}}<li><article><h2><a href="{{.CanonicalURL}}">{{.PartNumber}}</a></h2><p>{{.Name}}</p><small>{{.Manufacturer}}</small></article></li>{{end}}</ul>
<nav aria-label="Pagination">{{if .PreviousURL}}<a href="{{.PreviousURL}}">{{.Text.PreviousPage}}</a>{{end}} {{if .NextURL}}<a href="{{.NextURL}}">{{.Text.NextPage}}</a>{{end}}</nav>{{end}}
{{template "public-footer" .}}{{end}}

{{define "catalog-listing"}}{{template "public-header" .}}
{{if .Breadcrumbs}}<nav class="breadcrumbs" aria-label="Breadcrumb"><a href="{{.CatalogURL}}">{{.Text.Catalog}}</a>{{range .Breadcrumbs}} <span aria-hidden="true">/</span> <a href="{{.URL}}">{{.Name}}</a>{{end}}</nav>{{end}}
<div class="catalog-heading"><div><p class="eyebrow">{{.Text.Catalog}}</p><h1>{{.Title}}</h1></div><form action="{{.CatalogURL}}" method="get" role="search" class="catalog-search"><input type="hidden" name="lang" value="{{.Language}}"><label>{{.Text.SearchLabel}} <input name="q" value="{{.Query}}"></label><button>{{.Text.Search}}</button></form></div>
{{if .CategoryLinks}}<details class="catalog-disclosure" open><summary>{{.Text.Category}}</summary><nav class="category-browser" aria-label="{{.Text.Category}}"><ul>{{range .CategoryLinks}}<li><a href="{{.URL}}"><span>{{.Name}}</span><small>{{.SubtreePublic}}</small></a></li>{{end}}</ul></nav></details>{{end}}
{{if .ChildCategories}}<section class="category-children"><h2>{{.Text.Category}}</h2><ul>{{range .ChildCategories}}<li><a href="{{.URL}}"><strong>{{.Name}}</strong><span>{{.DirectPublic}} direct · {{.SubtreePublic}} total</span></a></li>{{end}}</ul></section>{{end}}
{{if .ShowFilters}}<details class="catalog-disclosure filter-disclosure" open><summary>{{.Text.Filters}}</summary><form action="{{.FormAction}}" method="get" class="catalog-filters"><input type="hidden" name="lang" value="{{.Language}}"><label>{{.Text.SearchLabel}} <input name="q" value="{{.Query}}"></label>
{{if .ManufacturerOptions}}<label>{{.Text.Manufacturer}} <select name="manufacturer_id"><option value="">{{.Text.All}}</option>{{range .ManufacturerOptions}}<option value="{{.Value}}"{{if .Selected}} selected{{end}}>{{.Label}}</option>{{end}}</select></label>{{end}}
{{if .BrandOptions}}<label>{{.Text.Brand}} <select name="brand_id"><option value="">{{.Text.All}}</option>{{range .BrandOptions}}<option value="{{.Value}}"{{if .Selected}} selected{{end}}>{{.Label}}</option>{{end}}</select></label>{{end}}
{{if .CategoryOptions}}<label>{{.Text.Category}} <select name="category_id"><option value="">{{.Text.All}}</option>{{range .CategoryOptions}}<option value="{{.Value}}"{{if .Selected}} selected{{end}}>{{.Label}}</option>{{end}}</select></label>{{end}}<button>{{.Text.Search}}</button>{{if .ClearURL}}<a class="clear-filters" href="{{.ClearURL}}">{{.Text.ClearFilters}}</a>{{end}}</form></details>{{end}}
{{if .NoResults}}<section class="notice"><h2>{{.Text.NoProducts}}</h2><p>{{.Text.NoProductsPrefix}} <strong>{{.Query}}</strong>.</p><a class="button" href="{{.RequestURL}}">{{.Text.RequestThisPart}}</a></section>{{else}}
<div class="listing-toolbar"><p><strong>{{.Listing.Total}}</strong> products</p><form action="{{.FormAction}}" method="get"><input type="hidden" name="lang" value="{{.Language}}">{{if .Query}}<input type="hidden" name="q" value="{{.Query}}">{{end}}{{if .ManufacturerID}}<input type="hidden" name="manufacturer_id" value="{{.ManufacturerID}}">{{end}}{{if .BrandID}}<input type="hidden" name="brand_id" value="{{.BrandID}}">{{end}}{{if .CategoryID}}<input type="hidden" name="category_id" value="{{.CategoryID}}">{{end}}<label>Sort <select name="sort"><option value="part_number"{{if eq .Listing.Sort "part_number"}} selected{{end}}>{{.Text.PartNumber}}</option><option value="name"{{if eq .Listing.Sort "name"}} selected{{end}}>{{.Text.Name}}</option><option value="manufacturer"{{if eq .Listing.Sort "manufacturer"}} selected{{end}}>{{.Text.Manufacturer}}</option><option value="brand"{{if eq .Listing.Sort "brand"}} selected{{end}}>{{.Text.Brand}}</option><option value="lifecycle"{{if eq .Listing.Sort "lifecycle"}} selected{{end}}>{{.Text.Lifecycle}}</option></select></label><label>Direction <select name="direction"><option value="asc"{{if eq .Listing.Direction "asc"}} selected{{end}}>A–Z</option><option value="desc"{{if eq .Listing.Direction "desc"}} selected{{end}}>Z–A</option></select></label><button>Apply</button></form></div>
{{if .Listing.Rows}}{{$columns := .Listing.Columns}}<div class="catalog-table-region" role="region" aria-label="{{.Title}}" tabindex="0"><table class="catalog-table"><thead><tr>{{range $columns}}<th scope="col">{{.Label}}{{if .PreferredUnit}} <small>({{.PreferredUnit}})</small>{{end}}</th>{{end}}</tr></thead><tbody>{{range .Listing.Rows}}{{$row := .}}<tr data-product-row="{{$row.ProductID}}">{{range $columns}}<td data-label="{{.Label}}" data-mobile="{{if .MobileVisible}}true{{else}}false{{end}}">{{if eq .Key "part_number"}}<a href="{{$row.ProductURL}}"><strong>{{index $row.Values .Key}}</strong></a><span class="row-more-slot" data-row-more="{{$row.ProductID}}"></span>{{else if eq .Key "documents"}}{{if $row.Documents}}<ul class="document-links">{{range $row.Documents}}<li><a href="{{.URL}}">{{.Label}}</a></li>{{end}}</ul>{{else}}<span aria-label="Not available">—</span>{{end}}{{else if eq .Key "rfq"}}<span class="rfq-select-slot" data-rfq-select="{{$row.ProductID}}" data-part-number="{{index $row.Values "part_number"}}"></span><a class="compact-action" href="{{$row.RFQURL}}">{{$.Text.RequestQuote}}</a>{{else}}{{with index $row.Values .Key}}{{.}}{{else}}<span aria-label="Not available">—</span>{{end}}{{end}}</td>{{end}}</tr>{{end}}</tbody></table></div><div id="listing-rfq-island" data-select-label="{{.Text.SelectForRFQ}}" data-selected-label="{{.Text.SelectedProducts}}" data-clear-label="{{.Text.ClearSelection}}" data-request-label="{{.Text.RequestQuote}}" data-more-label="{{.Text.MoreDetails}}" data-less-label="{{.Text.LessDetails}}"></div><script type="module" src="/static/public/public-islands.js"></script>{{else}}<section class="notice"><h2>{{.Text.NoProducts}}</h2><p>This category is available but has no published products.</p></section>{{end}}
<nav class="pagination" aria-label="Pagination">{{if .PreviousURL}}<a href="{{.PreviousURL}}">{{.Text.PreviousPage}}</a>{{end}}<span>Page {{.Listing.Page}}{{if .Listing.PageCount}} of {{.Listing.PageCount}}{{end}}</span>{{if .NextURL}}<a href="{{.NextURL}}">{{.Text.NextPage}}</a>{{end}}</nav>{{end}}
{{template "public-footer" .}}{{end}}

{{define "product"}}{{template "public-header" .}}
<article itemscope itemtype="https://schema.org/Product" data-product-id="{{.View.ID}}" data-revision="{{.View.Revision}}">
<p><a href="/search">Catalog</a></p><h1 itemprop="mpn">{{.View.PartNumber}}</h1>
{{if .View.Name}}<h2 itemprop="name">{{.View.Name}}</h2>{{end}}
<p>Manufacturer: <span itemprop="manufacturer">{{.View.Manufacturer}}</span></p>
{{if .View.Description}}<p itemprop="description">{{.View.Description}}</p>{{end}}
{{if .View.Specification}}<section><h2>Specifications</h2><dl><dt>Operating range</dt><dd>{{.View.Specification}}</dd></dl></section>{{end}}
{{if .View.Documents}}<section><h2>Documents</h2><ul>{{range .View.Documents}}<li><a href="{{.URL}}" rel="external">{{.Label}}</a></li>{{end}}</ul></section>{{end}}
<p><a class="button" href="{{.View.RFQURL}}">Request a quote</a></p>
<div id="rfq-island" data-product-id="{{.View.ID}}" data-part-number="{{.View.PartNumber}}"><noscript>JavaScript is optional; use the Request a quote link.</noscript></div>
</article><script type="application/ld+json">{{.JSONLD}}</script><script type="module" src="/static/public/public-islands.js"></script>
{{template "public-footer" .}}{{end}}

{{define "rfq"}}{{template "public-header" .}}
<h1>{{.Text.RFQTitle}}</h1>{{if .Error}}<p class="error" role="alert">{{.Error}}</p>{{end}}
<form method="post" action="{{.RFQURL}}"><input type="hidden" name="csrf_token" value="{{.CSRF}}"><input type="hidden" name="submission_key" value="{{.SubmissionKey}}">
{{if .Products}}<input type="hidden" name="kind" value="catalog"><fieldset class="rfq-products"><legend>{{.Text.CatalogProduct}}</legend><ul>{{range .Products}}<li><input type="hidden" name="product_id" value="{{.ID}}"><strong>{{.PartNumber}}</strong>{{if .Name}} — {{.Name}}{{end}}</li>{{end}}</ul></fieldset>
{{else}}<input type="hidden" name="kind" value="requested"><input type="hidden" name="raw_query" value="{{.RawQuery}}"><label>{{.Text.RequestedPart}} <input name="requested" value="{{.Requested}}" required></label>{{if .RawQuery}}<p>{{.Text.OriginalSearch}}: <code>{{.RawQuery}}</code></p>{{end}}{{end}}
<label>{{.Text.Name}} <input name="name" value="{{.Name}}" required></label><label>{{.Text.Email}} <input name="email" type="email" value="{{.Email}}" required></label>
<label>{{.Text.QuantityOptional}} <input name="quantity" value="{{.Quantity}}"></label><label>{{.Text.Notes}} <textarea name="notes">{{.Notes}}</textarea></label>
<button type="submit">{{.Text.SubmitRFQ}}</button></form>{{template "public-footer" .}}{{end}}

{{define "receipt"}}{{template "public-header" .}}<h1>{{.Text.RFQReceived}}</h1><p>{{.Receipt.Message}}</p><p>{{.Text.Reference}}: <strong>{{.Receipt.RFQID}}</strong></p>
{{if .Receipt.Replay}}<p>{{.Text.ReplayNotice}}</p>{{end}}{{template "public-footer" .}}{{end}}

{{define "login"}}<!doctype html><html lang="{{.Language}}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>{{.Title}}</title><link rel="stylesheet" href="/static/admin/style.css"></head><body>
<div id="admin-login-root" data-language="{{.Language}}" data-action="{{.ActionURL}}" data-title="{{.Text.AdminTitle}}" data-email-label="{{.Text.Email}}" data-password-label="{{.Text.Password}}" data-token-label="{{.Text.TemporaryToken}}" data-sign-in="{{.Text.SignIn}}" data-catalog="{{.Text.Catalog}}" data-request-part="{{.Text.RequestPart}}" data-footer="{{.Text.Footer}}" data-poc-help="{{.Text.POCHelp}}" data-email="{{.Email}}" data-error="{{.Error}}" data-poc="{{if .POC}}true{{else}}false{{end}}"><noscript>JavaScript is required for Prods Admin.</noscript></div>
<script type="module" src="/static/admin/admin.js"></script></body></html>{{end}}

{{define "set-password"}}{{template "header" .}}<h1>{{.Text.SetPasswordTitle}}</h1>
{{if .Success}}<p>{{.Text.PasswordSaved}} <strong>{{.Email}}</strong>. {{.Text.CanNow}} <a href="{{.LoginURL}}">{{.Text.SignInLink}}</a>.</p>
{{else}}{{if .Error}}<p class="error" role="alert">{{.Error}}</p>{{end}}
<form method="post" action="{{.ActionURL}}"><input type="hidden" name="token" value="{{.Token}}">
<label>{{.Text.NewPassword}} <input name="password" type="password" autocomplete="new-password" required></label>
<label>{{.Text.ConfirmPassword}} <input name="password_confirmation" type="password" autocomplete="new-password" required></label>
<p>{{.Text.PasswordRequirements}}</p><button type="submit">{{.Text.SetPassword}}</button></form>{{end}}
{{template "footer" .}}{{end}}

{{define "admin"}}<!doctype html><html lang="{{.Language}}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="csrf-token" content="{{.CSRF}}"><title>Prods Admin</title><link rel="stylesheet" href="/static/admin/style.css"></head>
<body><div id="admin-root"><h1>Loading protected Admin…</h1><p>JavaScript is required for the Admin application.</p></div>
<script type="module" src="/static/admin/admin.js"></script></body></html>{{end}}
