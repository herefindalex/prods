{
  "name": "prods-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "pnpm run build:system && pnpm run build:public && pnpm run build:admin",
    "build:styles": "node scripts/build-styles.mjs",
    "build:public": "pnpm run build:styles && vite build --config vite.public.config.ts",
    "build:system": "vite build --config vite.system.config.ts",
    "build:admin": "vite build --config vite.admin.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "antd": "^6.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0"
  },
  "packageManager": "pnpm@10.28.1"
}
