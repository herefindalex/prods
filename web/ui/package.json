{
  "name": "prods-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.dev.config.ts",
    "build": "vite build --config vite.system.config.ts && node scripts/build-styles.mjs && vite build --config vite.public.config.ts && vite build --config vite.admin.config.ts",
    "build:styles": "node scripts/build-styles.mjs",
    "build:public": "node scripts/build-styles.mjs && vite build --config vite.public.config.ts",
    "build:system": "vite build --config vite.system.config.ts",
    "build:admin": "vite build --config vite.admin.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@refinedev/core": "5.0.12",
    "@refinedev/react-router": "2.0.4",
    "@tanstack/react-query": "5.102.8",
    "antd": "6.6.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "7.18.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@10.28.1"
}
